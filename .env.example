# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=defaultdb
DB_USER=root
DB_PASS=change-me

# MoMo (captureWallet)
# Sandbox endpoint (default in code): https://test-payment.momo.vn/v2/gateway/api/create
# Production endpoint can be configured with MOMO_ENDPOINT
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://your-domain.example/api/payments/momo/return.php
MOMO_IPN_URL=https://your-domain.example/api/payments/momo/ipn.php
MOMO_PARTNER_NAME=Store NagaMC
MOMO_STORE_ID=StoreNagaMC
